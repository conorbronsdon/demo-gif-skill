# Minimal example tape used by docs/demo.tape to show the skill's core loop.
# Regenerate: vhs docs/sample.tape   (run from repo root; renders in ~1s)
Output docs/sample.gif

Set Shell "bash"
Set FontSize 24
Set Width 900
Set Height 300
Set Theme "Dracula"

Type "echo 'hello from vhs'"
Enter
Sleep 1s
